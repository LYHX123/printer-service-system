generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  ENGINEER
  RECEPTIONIST
}

enum EquipmentType {
  PRINTER
  COPIER
  LAPTOP
  DESKTOP_COMPUTER
  PROJECTOR
  CCTV_SYSTEM
  OTHER
}

enum ServiceType {
  REPAIR
  MAINTENANCE
  UPGRADE
  REFURBISHMENT
  INSTALLATION
  INSPECTION
}

enum JobStatus {
  RECEIVED
  DIAGNOSING
  WAITING_SPARE_PARTS
  WAITING_CUSTOMER_APPROVAL
  REPAIRING
  TESTING
  READY_FOR_COLLECTION
  DELIVERED
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum PhotoType {
  BEFORE
  AFTER
}

enum TransactionType {
  IN
  OUT
  RETURN
  DAMAGE
  ADJUSTMENT
  REVERSAL
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  CONVERTED
  EXPIRED
}

enum PartCategory {
  TONER
  DRUM
  DEVELOPER
  FUSER
  MAINTENANCE_KIT
  ROLLER
  LAPTOP_PART
  DESKTOP_PART
  CCTV_PART
  PROJECTOR_PART
  GENERAL
}

enum ContractType {
  SERVICE_CONTRACT
  MAINTENANCE_AGREEMENT
  WARRANTY_DOCUMENT
  OTHER
}

enum ContractStatus {
  ACTIVE
  EXPIRED
  TERMINATED
}

enum CommunicationChannel {
  WHATSAPP
  EMAIL
}

enum CommunicationMessageType {
  JOB_RECEIVED
  JOB_IN_PROGRESS
  AWAITING_CUSTOMER_APPROVAL
  QUOTATION_SENT
  QUOTATION_APPROVED
  JOB_COMPLETED
  READY_FOR_COLLECTION
  PAYMENT_REMINDER
  GENERAL
}

enum LedgerEntryType {
  INCOME
  EXPENSE
}

enum LedgerPaymentMethod {
  MPESA
  BANK_TRANSFER
  CHEQUE
  CASH
  CARD
  OTHER
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

enum SalesPaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum TaskStatus {
  ACTIVE
  COMPLETED
}

// ─── Core Models ──────────────────────────────────────────────────────────────

model Company {
  id         String   @id @default(uuid())
  name       String
  code       String   @unique
  address    String?
  phone      String?
  email      String?
  logoUrl    String?
  stampUrl   String? // company stamp image embedded in PDF footer
  website    String?
  kraPin     String?
  vatPercent Decimal  @default(16) @db.Decimal(5, 2)
  currency   String   @default("KES")
  timezone   String   @default("Africa/Nairobi")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users                 User[]
  customers             Customer[]
  branches              CustomerBranch[]
  equipment             Equipment[]
  serviceJobs           ServiceJob[]
  quotations            Quotation[]
  spareParts            SparePart[]
  purchaseOrders        PurchaseOrder[]
  contracts             CustomerContract[]
  communicationLogs     CommunicationLog[]
  ledgerCategories      LedgerCategory[]
  ledgerEntries         LedgerEntry[]
  salesLedgerEntries    SalesLedgerEntry[]
  shopAccountCategories ShopAccountCategory[]
  shopAccountEntries    ShopAccountEntry[]
  tasks                 Task[]
  invoices              Invoice[]
  customerDocuments     CustomerDocument[]
  quotationDocuments    QuotationDocument[]
  quotationVersions     QuotationVersion[]
  invoiceDocuments      InvoiceDocument[]
  auditLogs             AuditLog[]
  dropboxConnection     DropboxConnection?
}

model User {
  id                  String    @id @default(uuid())
  companyId           String
  name                String
  username            String?   @unique
  email               String?   @unique
  passwordHash        String
  role                Role
  isActive            Boolean   @default(true)
  signatureUrl        String? // engineer's drawn/uploaded signature for PDF sign-off
  modulePermissions   String[]  @default([])
  // Login security
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  // Optional profile
  phone               String?
  department          String?
  position            String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  assignedJobs              ServiceJob[]           @relation("AssignedEngineer")
  createdJobs               ServiceJob[]           @relation("CreatedBy")
  jobPhotos                 JobPhoto[]
  repairReports             RepairReport[]
  statusLogs                JobStatusLog[]
  inventoryTransactions     InventoryTransaction[]
  purchaseOrders            PurchaseOrder[]
  createdQuotations         Quotation[]
  createdContracts          CustomerContract[]
  equipmentPhotos           EquipmentPhoto[]
  meterReadings             MeterReading[]
  communicationLogs         CommunicationLog[]
  createdLedgerEntries      LedgerEntry[]
  createdSalesLedgerEntries SalesLedgerEntry[]
  createdShopAccountEntries ShopAccountEntry[]
  createdTasks              Task[]                 @relation("TaskCreatedBy")
  taskParticipations        TaskParticipant[]
  createdTaskSteps          TaskStep[]             @relation("TaskStepCreatedBy")
  uploadedTaskStepImages    TaskStepImage[]
  createdInvoices           Invoice[]
  uploadedCustomerDocuments CustomerDocument[]
  auditLogs                 AuditLog[]
  createdReceiptAllocations ReceiptAllocation[]
  createdDropboxConnections DropboxConnection[]
  createdQuotationVersions  QuotationVersion[]
}

model Customer {
  id          String   @id @default(uuid())
  companyId   String
  code        String   @unique
  companyName String
  shortName   String? // e.g. "CSCEC" — reserved for future Dropbox/Quotation file naming (QT00455-CSCEC-V1.xlsx); not unique, not sanitized here
  name        String?
  pinNumber   String?
  phone       String?
  location    String?
  email       String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company            Company            @relation(fields: [companyId], references: [id])
  branches           CustomerBranch[]
  documents          CustomerDocument[]
  equipment          Equipment[]
  serviceJobs        ServiceJob[]
  quotations         Quotation[]
  contracts          CustomerContract[]
  communicationLogs  CommunicationLog[]
  salesLedgerEntries SalesLedgerEntry[]
  invoices           Invoice[]
  ledgerEntries      LedgerEntry[]
}

// Branches or project sites that belong to a customer — surfaced in the UI as "Project"
model CustomerBranch {
  id            String   @id @default(uuid())
  companyId     String
  customerId    String
  name          String // e.g. "KL HQ", "PJ Branch", "Setia Alam Site" — UI label: Project Name
  address       String?
  phone         String?
  contactPerson String?
  contactEmail  String?
  notes         String?
  isPrimary     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company     Company            @relation(fields: [companyId], references: [id])
  customer    Customer           @relation(fields: [customerId], references: [id])
  equipment   Equipment[]
  serviceJobs ServiceJob[]
  contracts   CustomerContract[]
  documents   CustomerDocument[]
  quotations  Quotation[]

  @@index([customerId])
}

enum DocumentStorageProvider {
  LOCAL
  DROPBOX
}

// A file attached to a Customer (optionally scoped to one of its Projects).
// Kept behind a storage-provider abstraction (src/lib/storage/) so a future
// Dropbox provider can be added without changing this model or its consumers.
model CustomerDocument {
  id               String                  @id @default(uuid())
  companyId        String
  customerId       String
  projectId        String?
  documentType     String?
  originalFileName String
  storageKey       String
  storageProvider  DocumentStorageProvider @default(LOCAL)
  mimeType         String
  fileSize         Int
  uploadedById     String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  company    Company         @relation(fields: [companyId], references: [id])
  customer   Customer        @relation(fields: [customerId], references: [id])
  project    CustomerBranch? @relation(fields: [projectId], references: [id])
  uploadedBy User            @relation(fields: [uploadedById], references: [id])

  @@index([customerId])
  @@index([projectId])
}

// Minimal, append-only activity log. entityType/action are plain strings
// (not enums) since this taxonomy grows as more modules adopt it.
model AuditLog {
  id            String   @id @default(uuid())
  companyId     String
  entityType    String
  entityId      String
  action        String
  performedById String
  metadata      Json?
  createdAt     DateTime @default(now())

  company     Company @relation(fields: [companyId], references: [id])
  performedBy User    @relation(fields: [performedById], references: [id])

  @@index([companyId, entityType, entityId])
}

// Dropbox Foundation (Phase 1) — one OAuth connection per Company. Only the
// refresh token is persisted (encrypted), never the App Secret or the
// short-lived access token, which is minted on demand from the refresh
// token at request time (see src/lib/dropbox/).
model DropboxConnection {
  id                    String    @id @default(uuid())
  companyId             String    @unique
  provider              String    @default("dropbox")
  accountId             String?
  accountName           String?
  accountEmail          String?
  encryptedRefreshToken String
  status                String    @default("CONNECTED") // CONNECTED | DISCONNECTED
  connectedAt           DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  createdById           String?

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User?   @relation(fields: [createdById], references: [id])
}

model Equipment {
  id             String        @id @default(uuid())
  companyId      String
  customerId     String
  branchId       String? // optional: which branch/site this device is located at
  serialNumber   String        @unique
  assetNumber    String? // optional: internal asset tag (e.g. ASSET-0042)
  brand          String
  model          String
  type           EquipmentType
  purchaseDate   DateTime?
  warrantyExpiry DateTime? // manufacturer warranty expiry date
  notes          String? // free-text specs (type-specific template in UI)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company       Company          @relation(fields: [companyId], references: [id])
  customer      Customer         @relation(fields: [customerId], references: [id])
  branch        CustomerBranch?  @relation(fields: [branchId], references: [id])
  serviceJobs   ServiceJob[]
  photos        EquipmentPhoto[]
  meterReadings MeterReading[]
}

model ServiceJob {
  id              String      @id @default(uuid())
  jobNumber       String      @unique
  companyId       String
  customerId      String
  branchId        String? // optional: which branch/site the job is for
  equipmentId     String
  quotationId     String?     @unique // set when this job was created from a quotation
  serviceType     ServiceType
  assignedToId    String
  createdById     String
  status          JobStatus   @default(RECEIVED)
  priority        Priority    @default(NORMAL)
  problemDesc     String
  technicianNotes String? // raw field notes from engineer; used as AI report input
  receivedDate    DateTime    @default(now())
  dueDate         DateTime?
  completedAt     DateTime?
  meterBlack      Int? // page counter – shown only for PRINTER / COPIER
  meterColor      Int?
  warrantyPeriod  Int? // days; set at DELIVERED
  warrantyExpires DateTime? // computed: completedAt + warrantyPeriod
  labourCost      Decimal     @default(0) @db.Decimal(10, 2)
  partsCost       Decimal     @default(0) @db.Decimal(10, 2)
  totalCost       Decimal     @default(0) @db.Decimal(10, 2)
  signatureUrl    String?
  signedAt        DateTime?
  internalNotes   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  company    Company         @relation(fields: [companyId], references: [id])
  customer   Customer        @relation(fields: [customerId], references: [id])
  branch     CustomerBranch? @relation(fields: [branchId], references: [id])
  equipment  Equipment       @relation(fields: [equipmentId], references: [id])
  assignedTo User            @relation("AssignedEngineer", fields: [assignedToId], references: [id])
  createdBy  User            @relation("CreatedBy", fields: [createdById], references: [id])
  quotation  Quotation?      @relation("QuotationConversion", fields: [quotationId], references: [id])

  photos                JobPhoto[]
  report                RepairReport?
  statusLogs            JobStatusLog[]
  inventoryTransactions InventoryTransaction[]
  meterReadings         MeterReading[]
  communicationLogs     CommunicationLog[]
}

model Quotation {
  id                  String          @id @default(uuid())
  quotationNumber     String          @unique // user-entered business number (e.g. QT00455); legacy rows keep their original auto-generated QTYYYYMM-NNN value
  quotationSortNumber Int? // trailing numeric portion of quotationNumber, for natural-number sort — see src/lib/numbering.ts
  // Dropbox document version this quotation is currently on — 1 at creation,
  // incremented by exactly 1 (atomically, in the same update as the business
  // data change) every time Adjust Quotation saves. Never touched by a
  // Dropbox sync retry — see resyncQuotationDropbox — so a repeat retry
  // always targets the same version instead of silently advancing it.
  currentVersion      Int             @default(1)
  companyId           String
  customerId       String
  customerBranchId String? // selected Project ("Head Office" when null)
  contactName      String? // contact snapshot, frozen at creation/selection time
  contactPhone     String?
  contactEmail     String?
  contactAddress   String?
  status           QuotationStatus @default(DRAFT)
  validUntil       DateTime?
  subtotal         Decimal         @default(0) @db.Decimal(10, 2)
  vatPercent       Decimal         @default(0) @db.Decimal(5, 2)
  totalCost        Decimal         @default(0) @db.Decimal(10, 2)
  remarks          String? // customer-facing remarks on quotation
  internalNotes    String?
  createdById      String
  approvedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  customer       Customer        @relation(fields: [customerId], references: [id])
  customerBranch CustomerBranch? @relation(fields: [customerBranchId], references: [id])
  createdBy      User            @relation(fields: [createdById], references: [id])

  items             QuotationItem[]
  convertedJob      ServiceJob?        @relation("QuotationConversion")
  communicationLogs CommunicationLog[]
  invoice           Invoice? // at most one — quotationId is @unique on Invoice
  documents         QuotationDocument[]
  versions          QuotationVersion[]
}

model QuotationItem {
  id                    String   @id @default(uuid())
  quotationId           String
  partId                String?
  description           String? // legacy free-text item; new items are always stock-linked via partId
  quantity              Int      @default(1)
  unitPrice             Decimal  @db.Decimal(10, 2)
  subtotal              Decimal  @db.Decimal(10, 2)
  // Snapshot of the stock item at the time it was added to the quotation, frozen so
  // later edits to the SparePart record never change the wording of past quotations.
  stockCategory         String?
  brandSnapshot         String?
  nameSnapshot          String?
  modelSnapshot         String?
  specificationSnapshot String?
  unitSnapshot          String? // Stock item's Unit at quotation-save time
  pictureSnapshot       String? // copy of the Stock item's picture at quotation-save time (own file, not a live link) — see saveQuotationItemPictureSnapshot in src/lib/uploads.ts
  createdAt             DateTime @default(now())

  quotation Quotation  @relation(fields: [quotationId], references: [id])
  part      SparePart? @relation(fields: [partId], references: [id])
}

enum QuotationFileType {
  PDF
  XLSX
}

// Quotation Dropbox — one row per (quotation, file type, version, isFinal).
// V1/V2/V3... rows (isFinal = false) are never overwritten by a later
// version — each Adjust Quotation save creates new rows at
// Quotation.currentVersion (already incremented), archiving every prior
// version's actual Dropbox file untouched. A repeat sync for the *same*
// version (e.g. a Dropbox retry after a transient failure) still upserts
// the same row, so retrying is idempotent and never advances the version.
//
// isFinal rows are the Approve-time snapshot ("QTxxxxx-SHORTNAME-FINAL.ext")
// — a genuinely separate artifact from the numbered versions, not just
// "one more version number" (see the Quotation Dropbox spec's explicit
// warning against modeling FINAL as version=999). `version` on a FINAL row
// records which version it was approved from, purely for reference.
model QuotationDocument {
  id              String                  @id @default(uuid())
  companyId       String
  quotationId     String
  fileType        QuotationFileType
  version         Int                     @default(1)
  isFinal         Boolean                 @default(false)
  storageKey      String
  storageProvider DocumentStorageProvider @default(LOCAL)
  mimeType        String
  fileSize        Int
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  company   Company   @relation(fields: [companyId], references: [id])
  quotation Quotation @relation(fields: [quotationId], references: [id])

  @@unique([quotationId, fileType, version, isFinal])
  @@index([quotationId])
}

// Immutable business-data snapshot for one Quotation version — what
// QuotationDocument's V1/V2/V3 *files* were actually generated from, frozen
// at that exact moment so a later Adjust (or a SparePart's name/price/brand
// changing under it) never rewrites history. `snapshot` holds everything
// the Detail page needs to render that version standalone: quotation totals
// and dates, the customer's *display* fields (not just its id — the
// customer record itself can change later), and each item's full
// description (not just a partId) — see
// src/lib/quotationExcel/versionSnapshot.ts for the exact shape and where
// it's built. One row per version, created once and never updated.
model QuotationVersion {
  id          String   @id @default(uuid())
  companyId   String
  quotationId String
  version     Int
  snapshot    Json
  createdAt   DateTime @default(now())
  createdById String?

  company   Company   @relation(fields: [companyId], references: [id])
  quotation Quotation @relation(fields: [quotationId], references: [id])
  createdBy User?     @relation(fields: [createdById], references: [id])

  @@unique([quotationId, version])
  @@index([quotationId])
}

// One Invoice per Quotation at most (quotationId is unique when present — enforced from
// the invoice_salesledger_receipt_refactor migration onward). An Invoice may also be
// created directly, with no Quotation at all (source = DIRECT, quotationId = null).
enum InvoiceSource {
  FROM_QUOTATION
  DIRECT
}

model Invoice {
  id                String        @id @default(uuid())
  invoiceNumber     String        @unique // user-entered business number (e.g. CN00455); legacy rows keep their original auto-generated INVYYYYMM-NNN value
  invoiceSortNumber Int? // trailing numeric portion of invoiceNumber, for natural-number sort — see src/lib/numbering.ts
  source            InvoiceSource @default(FROM_QUOTATION)
  companyId         String
  quotationId       String?       @unique
  customerId        String
  customerPin       String? // snapshot, editable at generation time — may differ from the customer record
  date              DateTime
  subtotal          Decimal       @db.Decimal(12, 2)
  vatPercent        Decimal       @db.Decimal(5, 2)
  vatAmount         Decimal       @db.Decimal(12, 2)
  totalAmount       Decimal       @db.Decimal(12, 2)
  receivedBy        String?
  remarks           String? // free-text notes, mainly used on Direct invoices (no Quotation.remarks to inherit from)
  // Stock-deduction workflow. Existing rows (all created before this field existed) were
  // backfilled to CONFIRMED without retroactive InventoryTransaction rows. Going forward,
  // every new invoice (from either source) is born DRAFT and only moves stock once
  // explicitly confirmed — see confirmInvoice()/cancelInvoice() in src/lib/actions/invoices.ts.
  status        InvoiceStatus @default(DRAFT)
  confirmedById String? // plain user-id reference, no FK relation (avoids widening User)
  confirmedAt   DateTime?
  cancelledById String?
  cancelledAt   DateTime?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company          Company           @relation(fields: [companyId], references: [id])
  quotation        Quotation?        @relation(fields: [quotationId], references: [id])
  customer         Customer          @relation(fields: [customerId], references: [id])
  createdBy        User              @relation(fields: [createdById], references: [id])
  items            InvoiceItem[]
  salesLedgerEntry SalesLedgerEntry?
  documents        InvoiceDocument[]
}

enum InvoiceFileType {
  PDF
  XLSX
}

// Invoice Dropbox Phase 1 — one row per (invoice, file type). No versioning
// (unlike QuotationDocument): an Invoice's official file is always exactly
// "{InvoiceNumber}.{ext}", and a re-sync (auto after an edit, or manual
// retry) just overwrites the same Dropbox path and updates this same row —
// invoiceNumber is already globally unique (@unique above), so there is
// never a need for a Customer Short Name or a version number in the path.
model InvoiceDocument {
  id              String                  @id @default(uuid())
  companyId       String
  invoiceId       String
  fileType        InvoiceFileType
  storageKey      String
  storageProvider DocumentStorageProvider @default(LOCAL)
  mimeType        String
  fileSize        Int
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([invoiceId, fileType])
  @@index([invoiceId])
}

model InvoiceItem {
  id                    String  @id @default(uuid())
  invoiceId             String
  partId                String?
  description           String
  unit                  String?
  quantity              Int
  unitPrice             Decimal @db.Decimal(10, 2)
  amount                Decimal @db.Decimal(10, 2)
  // Snapshot of the stock item at invoice-generation time — see QuotationItem for rationale.
  stockCategory         String?
  brandSnapshot         String?
  nameSnapshot          String?
  modelSnapshot         String?
  specificationSnapshot String?

  invoice Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  part    SparePart? @relation(fields: [partId], references: [id])
}

model JobPhoto {
  id           String    @id @default(uuid())
  jobId        String
  photoType    PhotoType
  fileUrl      String
  fileName     String
  mimeType     String
  sizeBytes    Int
  caption      String?
  uploadedById String
  createdAt    DateTime  @default(now())

  job        ServiceJob @relation(fields: [jobId], references: [id])
  uploadedBy User       @relation(fields: [uploadedById], references: [id])
}

model RepairReport {
  id              String   @id @default(uuid())
  jobId           String   @unique
  writtenById     String
  diagnosis       String
  workDone        String
  partsUsed       String?
  recommendations String?
  labourCost      Decimal  @default(0) @db.Decimal(10, 2)
  partsCost       Decimal  @default(0) @db.Decimal(10, 2)
  rawInput        String? // technician notes passed to AI for report generation
  isAiGenerated   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  job       ServiceJob @relation(fields: [jobId], references: [id])
  writtenBy User       @relation(fields: [writtenById], references: [id])
  parts     JobPart[]
}

model JobPart {
  id        String   @id @default(uuid())
  reportId  String
  partId    String?
  partName  String
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  subtotal  Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  report RepairReport @relation(fields: [reportId], references: [id])
  part   SparePart?   @relation(fields: [partId], references: [id])
}

model JobStatusLog {
  id          String   @id @default(uuid())
  jobId       String
  changedById String
  fromStatus  String
  toStatus    String
  note        String?
  createdAt   DateTime @default(now())

  job       ServiceJob @relation(fields: [jobId], references: [id])
  changedBy User       @relation(fields: [changedById], references: [id])
}

// ─── Spare Parts Inventory ────────────────────────────────────────────────────

model SparePart {
  id             String       @id @default(uuid())
  companyId      String
  partNumber     String       @unique // server-generated; no longer a user-facing form field
  name           String
  model          String? // unified Stock field set: Brand / Name / Model / Specification / Quantity / Picture
  specification  String? // unified free-text spec/notes field (multi-line); backfilled from description+compatibleWith+supplier
  description    String? // legacy; retained for existing data, superseded by `specification` in the UI
  category       PartCategory @default(GENERAL)
  brand          String?
  supplier       String?
  compatibleWith String? // e.g. "HP LaserJet Pro, Canon iR"
  unit           String? // free text, e.g. "PCS", "BOX", "SET" — user-entered, trimmed+uppercased on save; nullable, no forced backfill for historical rows
  unitCost       Decimal      @default(0) @db.Decimal(10, 2)
  sellingPrice   Decimal      @default(0) @db.Decimal(10, 2)
  reorderLevel   Int          @default(0)
  imageUrl       String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  company            Company                @relation(fields: [companyId], references: [id])
  stock              InventoryStock?
  transactions       InventoryTransaction[]
  jobParts           JobPart[]
  purchaseOrderItems PurchaseOrderItem[]
  quotationItems     QuotationItem[]
  invoiceItems       InvoiceItem[]
}

model InventoryStock {
  id          String    @id @default(uuid())
  partId      String    @unique
  quantity    Int       @default(0)
  location    String?
  lastCounted DateTime?
  updatedAt   DateTime  @updatedAt

  part SparePart @relation(fields: [partId], references: [id])
}

model InventoryTransaction {
  id             String          @id @default(uuid())
  companyId      String
  partId         String
  jobId          String?
  type           TransactionType
  quantity       Int
  unitPrice      Decimal?        @db.Decimal(10, 2)
  reference      String?
  // Structured stock-movement fields (additive alongside the existing free-text
  // `reference`/`jobId`). Nullable so pre-existing rows are left untouched rather
  // than backfilled with invented numbers.
  quantityBefore Int?
  quantityAfter  Int?
  referenceType  String? // MANUAL | PURCHASE | INVOICE | INVOICE_CANCEL | INITIAL_MIGRATION
  remark         String?
  performedById  String
  createdAt      DateTime        @default(now())

  part        SparePart   @relation(fields: [partId], references: [id])
  job         ServiceJob? @relation(fields: [jobId], references: [id])
  performedBy User        @relation(fields: [performedById], references: [id])
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  companyId    String
  poNumber     String              @unique
  supplierName String
  status       PurchaseOrderStatus @default(DRAFT)
  orderedDate  DateTime?
  expectedDate DateTime?
  totalAmount  Decimal             @default(0) @db.Decimal(10, 2)
  notes        String?
  createdById  String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  company   Company             @relation(fields: [companyId], references: [id])
  createdBy User                @relation(fields: [createdById], references: [id])
  items     PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id               String   @id @default(uuid())
  poId             String
  partId           String
  quantityOrdered  Int
  quantityReceived Int      @default(0)
  unitPrice        Decimal  @db.Decimal(10, 2)
  createdAt        DateTime @default(now())

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])
  part          SparePart     @relation(fields: [partId], references: [id])
}

// ─── Customer Contracts ────────────────────────────────────────────────────────

model CustomerContract {
  id            String         @id @default(uuid())
  companyId     String
  customerId    String
  branchId      String? // optional: contract scoped to a specific branch
  title         String
  contractType  ContractType
  status        ContractStatus @default(ACTIVE)
  startDate     DateTime?
  endDate       DateTime?
  fileUrl       String? // stored PDF/document path
  fileName      String?
  fileSizeBytes Int?
  notes         String?
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  company   Company         @relation(fields: [companyId], references: [id])
  customer  Customer        @relation(fields: [customerId], references: [id])
  branch    CustomerBranch? @relation(fields: [branchId], references: [id])
  createdBy User            @relation(fields: [createdById], references: [id])
}

// ─── Equipment Photo Gallery ───────────────────────────────────────────────────

model EquipmentPhoto {
  id           String   @id @default(uuid())
  equipmentId  String
  fileUrl      String
  fileName     String
  mimeType     String
  sizeBytes    Int
  caption      String?
  uploadedById String
  createdAt    DateTime @default(now())

  equipment  Equipment @relation(fields: [equipmentId], references: [id])
  uploadedBy User      @relation(fields: [uploadedById], references: [id])
}

// ─── Printer / Copier Meter History ───────────────────────────────────────────

model MeterReading {
  id           String   @id @default(uuid())
  equipmentId  String
  jobId        String? // set when reading is captured at job intake
  readingDate  DateTime @default(now())
  blackPages   Int?
  colorPages   Int?
  recordedById String
  notes        String?
  createdAt    DateTime @default(now())

  equipment  Equipment   @relation(fields: [equipmentId], references: [id])
  job        ServiceJob? @relation(fields: [jobId], references: [id])
  recordedBy User        @relation(fields: [recordedById], references: [id])
}

// ─── Customer Communication Log ────────────────────────────────────────────────

model CommunicationLog {
  id             String                   @id @default(uuid())
  companyId      String
  customerId     String
  jobId          String?
  quotationId    String?
  channel        CommunicationChannel
  messageType    CommunicationMessageType
  recipient      String
  messageContent String
  status         String                   @default("SENT")
  createdById    String
  createdAt      DateTime                 @default(now())

  company   Company     @relation(fields: [companyId], references: [id])
  customer  Customer    @relation(fields: [customerId], references: [id])
  job       ServiceJob? @relation(fields: [jobId], references: [id])
  quotation Quotation?  @relation(fields: [quotationId], references: [id])
  createdBy User        @relation(fields: [createdById], references: [id])
}

// ─── Ledger Module (Income & Expense Book + Sales Ledger) ─────────────────────
// Independent, simple bookkeeping module — not linked to Quotations or Jobs.

model LedgerCategory {
  id        String          @id @default(uuid())
  companyId String
  type      LedgerEntryType
  name      String
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())

  company Company       @relation(fields: [companyId], references: [id])
  entries LedgerEntry[]

  @@unique([companyId, type, name])
}

model LedgerEntry {
  id            String              @id @default(uuid())
  companyId     String
  type          LedgerEntryType
  categoryId    String
  date          DateTime
  amount        Decimal             @db.Decimal(12, 2)
  paymentMethod LedgerPaymentMethod
  referenceNo   String?
  remark        String?
  // Set when this INCOME entry is a customer receipt that may be allocated against one or
  // more Sales Ledger invoices — see ReceiptAllocation. Left null for non-customer income
  // (e.g. "Other Income") and for all EXPENSE entries.
  customerId    String?
  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  company     Company             @relation(fields: [companyId], references: [id])
  category    LedgerCategory      @relation(fields: [categoryId], references: [id])
  customer    Customer?           @relation(fields: [customerId], references: [id])
  createdBy   User                @relation(fields: [createdById], references: [id])
  allocations ReceiptAllocation[]
}

// ─── Shop Account Module ───────────────────────────────────────────────────────
// Independent from Ledger/SalesLedgerEntry — day-to-day shop purchases, expenses
// and income recorded by the shop manager. Not auto-merged into the company Ledger.

model ShopAccountCategory {
  id        String          @id @default(uuid())
  companyId String
  type      LedgerEntryType
  name      String
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())

  company Company            @relation(fields: [companyId], references: [id])
  entries ShopAccountEntry[]

  @@unique([companyId, type, name])
}

model ShopAccountEntry {
  id                 String              @id @default(uuid())
  companyId          String
  date               DateTime
  type               LedgerEntryType
  categoryId         String
  description        String
  payee              String? // supplier / payee
  amount             Decimal             @db.Decimal(12, 2)
  paymentMethod      LedgerPaymentMethod
  attachmentUrl      String?
  attachmentFileName String?
  attachmentMimeType String?
  remarks            String?
  createdById        String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  company   Company             @relation(fields: [companyId], references: [id])
  category  ShopAccountCategory @relation(fields: [categoryId], references: [id])
  createdBy User                @relation(fields: [createdById], references: [id])
}

// ─── Task Module ─────────────────────────────────────────────────────────────

model Task {
  id          String     @id @default(uuid())
  companyId   String
  title       String
  status      TaskStatus @default(ACTIVE)
  createdById String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?

  company      Company           @relation(fields: [companyId], references: [id])
  createdBy    User              @relation("TaskCreatedBy", fields: [createdById], references: [id])
  participants TaskParticipant[]
  steps        TaskStep[]
}

model TaskParticipant {
  id     String @id @default(uuid())
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
}

model TaskStep {
  id          String   @id @default(uuid())
  taskId      String
  title       String
  description String?
  order       Int
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task      Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy User            @relation("TaskStepCreatedBy", fields: [createdById], references: [id])
  images    TaskStepImage[]
}

model TaskStepImage {
  id           String   @id @default(uuid())
  stepId       String
  url          String
  filename     String
  uploadedById String
  createdAt    DateTime @default(now())

  step       TaskStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])
}

model SalesLedgerEntry {
  id                String             @id @default(uuid())
  companyId         String
  date              DateTime
  customerName      String
  customerId        String?
  orderNo           String?
  referenceYear     Int? // sortable period (year*100+month, e.g. 202607), not a plain calendar year — see src/lib/ledger-reference.ts
  referenceSequence Int?
  invoiceAmount     Decimal            @db.Decimal(12, 2)
  amountReceived    Decimal            @default(0) @db.Decimal(12, 2)
  balance           Decimal            @db.Decimal(12, 2)
  paymentStatus     SalesPaymentStatus @default(UNPAID)
  remark            String?
  isArchived        Boolean            @default(false)
  // Set when this entry was created from Invoice Detail's "Create Sales Record" action —
  // at most one Sales Ledger entry per Invoice (enforced by @unique). Legacy/manual entries
  // (created directly in the Sales Ledger, not from an Invoice) keep this null forever.
  invoiceId         String?            @unique
  createdById       String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  company     Company             @relation(fields: [companyId], references: [id])
  customer    Customer?           @relation(fields: [customerId], references: [id])
  invoice     Invoice?            @relation(fields: [invoiceId], references: [id])
  createdBy   User                @relation(fields: [createdById], references: [id])
  allocations ReceiptAllocation[]

  @@index([companyId, referenceYear(sort: Desc), referenceSequence(sort: Desc)])
}

// Records one customer-receipt LedgerEntry being applied against one Sales Ledger invoice.
// A single receipt may be split across several invoices (several rows, same ledgerEntryId);
// a single invoice may receive several receipts over time (several rows, same
// salesLedgerEntryId). SalesLedgerEntry.amountReceived/balance/paymentStatus are always
// recomputed from SUM(allocatedAmount) here, never incremented by hand — see
// recomputeSalesLedgerEntry() in src/lib/actions/ledger.ts.
model ReceiptAllocation {
  id                 String   @id @default(uuid())
  ledgerEntryId      String
  salesLedgerEntryId String
  allocatedAmount    Decimal  @db.Decimal(12, 2)
  createdById        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ledgerEntry      LedgerEntry      @relation(fields: [ledgerEntryId], references: [id], onDelete: Cascade)
  salesLedgerEntry SalesLedgerEntry @relation(fields: [salesLedgerEntryId], references: [id])
  createdBy        User             @relation(fields: [createdById], references: [id])

  @@index([ledgerEntryId])
  @@index([salesLedgerEntryId])
}
